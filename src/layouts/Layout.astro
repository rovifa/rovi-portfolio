---
import "../styles/global.css";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Portofolio Rovi Fauzan Akbar — Squad Lead APM, Observability & Backend Engineer (Go) di perbankan",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧑‍💻</text></svg>" />
  </head>
  <body id="top">
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">Rovi Fauzan Akbar</a>
        <button
          type="button"
          class="nav-toggle"
          id="nav-toggle"
          aria-expanded="false"
          aria-controls="nav-links"
          aria-label="Buka menu navigasi"
        >
          <Icon name="menu" />
          <Icon name="x" />
        </button>
        <nav class="nav-links" id="nav-links">
          <a href="/#pengalaman">Pengalaman</a>
          <a href="/#studi-kasus">Studi Kasus</a>
          <a href="mailto:rovifauzan95@gmail.com">Kontak</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-copy">
          © {new Date().getFullYear()} Rovi Fauzan Akbar. Dibangun dengan Astro.
        </p>
        <div class="footer-links">
          <a
            class="icon-btn icon-btn-sm"
            href="https://github.com/rovifa"
            target="_blank"
            rel="noopener"
            aria-label="Kunjungi GitHub Rovi Fauzan Akbar"
          >
            <Icon name="github" />
          </a>
          <a
            class="icon-btn icon-btn-sm"
            href="https://www.linkedin.com/in/rovi-fauzan-akbar"
            target="_blank"
            rel="noopener"
            aria-label="Kunjungi LinkedIn Rovi Fauzan Akbar"
          >
            <Icon name="linkedin" />
          </a>
          <a
            class="icon-btn icon-btn-sm"
            href="mailto:rovifauzan95@gmail.com"
            aria-label="Kirim email ke Rovi Fauzan Akbar"
          >
            <Icon name="mail" />
          </a>
          <a class="btn btn-outline btn-sm" href="/cv.pdf" download>
            <Icon name="download" />
            Download CV
          </a>
          <a class="btn btn-outline btn-sm" href="#top">
            <Icon name="arrow-up" />
            Kembali ke atas
          </a>
        </div>
      </div>
    </footer>

    <script type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs";
      mermaid.initialize({
        startOnLoad: true,
        theme: "dark",
        securityLevel: "loose",
      });
    </script>

    <script>
      // iOS Safari only applies :active styles to elements once some
      // touch listener exists on the page — this no-op registers that
      // without changing behavior, so tap feedback on case cards works.
      document.body.addEventListener("touchstart", () => {}, {
        passive: true,
      });
    </script>

    <script>
      document.querySelectorAll(".copy-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const text = btn.getAttribute("data-copy");
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const input = document.createElement("textarea");
            input.value = text;
            input.style.position = "fixed";
            input.style.opacity = "0";
            document.body.appendChild(input);
            input.select();
            document.execCommand("copy");
            document.body.removeChild(input);
          }
          const original = btn.innerHTML;
          btn.innerHTML =
            '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
          btn.classList.add("copied");
          setTimeout(() => {
            btn.innerHTML = original;
            btn.classList.remove("copied");
          }, 1500);
        });
      });
    </script>

    <script>
      const navToggle = document.getElementById("nav-toggle");
      const navLinksEl = document.getElementById("nav-links");

      if (navToggle && navLinksEl) {
        const closeNav = () => {
          navLinksEl.classList.remove("is-open");
          navToggle.setAttribute("aria-expanded", "false");
          navToggle.setAttribute("aria-label", "Buka menu navigasi");
        };

        navToggle.addEventListener("click", () => {
          const isOpen = navLinksEl.classList.toggle("is-open");
          navToggle.setAttribute("aria-expanded", String(isOpen));
          navToggle.setAttribute(
            "aria-label",
            isOpen ? "Tutup menu navigasi" : "Buka menu navigasi"
          );
        });

        navLinksEl.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", closeNav);
        });

        document.addEventListener("click", (e) => {
          if (!navLinksEl.classList.contains("is-open")) return;
          const target = e.target;
          if (navToggle.contains(target) || navLinksEl.contains(target)) return;
          closeNav();
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") closeNav();
        });
      }
    </script>

    <script>
      function openMermaidModal(sourceEl) {
        const svg = sourceEl.querySelector("svg");
        if (!svg) return;

        const overlay = document.createElement("div");
        overlay.className = "mermaid-modal-overlay";

        const modal = document.createElement("div");
        modal.className = "mermaid-modal";

        const closeBtn = document.createElement("button");
        closeBtn.type = "button";
        closeBtn.className = "mermaid-modal-close";
        closeBtn.setAttribute("aria-label", "Tutup diagram");
        closeBtn.innerHTML =
          '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>';

        const stage = document.createElement("div");
        stage.className = "mermaid-modal-stage";

        const clone = svg.cloneNode(true);
        stage.appendChild(clone);

        const hint = document.createElement("div");
        hint.className = "mermaid-modal-hint";
        hint.textContent = "Cubit untuk zoom, geser untuk pindah";

        modal.append(closeBtn, stage, hint);
        overlay.appendChild(modal);
        document.body.appendChild(overlay);
        document.body.style.overflow = "hidden";

        let scale = 1;
        let panX = 0;
        let panY = 0;
        const applyTransform = () => {
          clone.style.transform =
            "translate(" + panX + "px, " + panY + "px) scale(" + scale + ")";
        };
        const clampScale = (s) => Math.min(6, Math.max(0.4, s));

        stage.addEventListener(
          "wheel",
          (e) => {
            e.preventDefault();
            scale = clampScale(scale * (e.deltaY < 0 ? 1.1 : 0.9));
            applyTransform();
          },
          { passive: false }
        );

        let dragging = false;
        let lastX = 0;
        let lastY = 0;
        stage.addEventListener("mousedown", (e) => {
          dragging = true;
          lastX = e.clientX;
          lastY = e.clientY;
        });
        window.addEventListener("mousemove", (e) => {
          if (!dragging) return;
          panX += e.clientX - lastX;
          panY += e.clientY - lastY;
          lastX = e.clientX;
          lastY = e.clientY;
          applyTransform();
        });
        window.addEventListener("mouseup", () => {
          dragging = false;
        });

        let touchState = null;
        stage.addEventListener(
          "touchstart",
          (e) => {
            if (e.touches.length === 2) {
              const [a, b] = e.touches;
              touchState = {
                mode: "pinch",
                startDist: Math.hypot(
                  a.clientX - b.clientX,
                  a.clientY - b.clientY
                ),
                startScale: scale,
              };
            } else if (e.touches.length === 1) {
              touchState = {
                mode: "pan",
                lastX: e.touches[0].clientX,
                lastY: e.touches[0].clientY,
              };
            }
          },
          { passive: true }
        );
        stage.addEventListener(
          "touchmove",
          (e) => {
            if (!touchState) return;
            if (touchState.mode === "pinch" && e.touches.length === 2) {
              const [a, b] = e.touches;
              const dist = Math.hypot(
                a.clientX - b.clientX,
                a.clientY - b.clientY
              );
              scale = clampScale(
                touchState.startScale * (dist / touchState.startDist)
              );
              applyTransform();
            } else if (touchState.mode === "pan" && e.touches.length === 1) {
              const dx = e.touches[0].clientX - touchState.lastX;
              const dy = e.touches[0].clientY - touchState.lastY;
              panX += dx;
              panY += dy;
              touchState.lastX = e.touches[0].clientX;
              touchState.lastY = e.touches[0].clientY;
              applyTransform();
            }
          },
          { passive: true }
        );
        stage.addEventListener(
          "touchend",
          () => {
            touchState = null;
          },
          { passive: true }
        );

        const close = () => {
          document.body.style.overflow = "";
          overlay.remove();
          document.removeEventListener("keydown", onKey);
        };
        const onKey = (e) => {
          if (e.key === "Escape") close();
        };
        closeBtn.addEventListener("click", close);
        overlay.addEventListener("click", (e) => {
          if (e.target === overlay) close();
        });
        document.addEventListener("keydown", onKey);
      }

      document.querySelectorAll("pre.mermaid").forEach((el) => {
        let hintEl = null;

        const dismissHint = () => {
          if (hintEl) {
            hintEl.remove();
            hintEl = null;
          }
          el.dataset.hintDismissed = "true";
        };

        const updateFade = () => {
          const canScrollRight =
            el.scrollWidth - el.clientWidth - el.scrollLeft > 4;
          el.classList.toggle("can-scroll", canScrollRight);

          if (canScrollRight && !hintEl && !el.dataset.hintDismissed) {
            hintEl = document.createElement("p");
            hintEl.className = "mermaid-hint";
            hintEl.textContent = "↔ Geser untuk melihat diagram lengkap";
            el.insertAdjacentElement("beforebegin", hintEl);
          } else if (!canScrollRight && hintEl) {
            hintEl.remove();
            hintEl = null;
          }
        };

        // Mermaid renders its SVG with width="100%" and no absolute
        // intrinsic size, so without this the browser falls back to a
        // default ~300px box and the diagram (text included) keeps
        // rescaling down as the viewport narrows. Pin the SVG to its own
        // viewBox size instead, so it renders at natural/readable size
        // and pre's overflow-x:auto handles the rest via horizontal
        // scroll.
        const fixSvgSize = () => {
          const svg = el.querySelector("svg");
          if (!svg || svg.dataset.sizeFixed) return;
          const viewBox = svg.getAttribute("viewBox");
          if (!viewBox) return;
          const parts = viewBox.split(/\s+/).map(Number);
          if (parts.length !== 4 || !(parts[2] > 0) || !(parts[3] > 0)) {
            return;
          }
          svg.style.width = parts[2] + "px";
          svg.style.height = parts[3] + "px";
          svg.style.maxWidth = "none";
          svg.dataset.sizeFixed = "true";
          updateFade();

          const expandBtn = document.createElement("button");
          expandBtn.type = "button";
          expandBtn.className = "mermaid-expand-btn";
          expandBtn.setAttribute("aria-label", "Perbesar diagram");
          expandBtn.innerHTML =
            '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="m21 3-7 7"/><path d="m3 21 7-7"/></svg>';
          expandBtn.addEventListener("click", () => openMermaidModal(el));
          el.appendChild(expandBtn);
        };

        const observer = new MutationObserver(fixSvgSize);
        observer.observe(el, { childList: true, subtree: true });
        el.addEventListener(
          "scroll",
          () => {
            dismissHint();
            updateFade();
          },
          { passive: true }
        );
        window.addEventListener("resize", updateFade);
        fixSvgSize();
        updateFade();
      });
    </script>

    <script>
      const revealEls = document.querySelectorAll(".reveal");
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (prefersReducedMotion || !("IntersectionObserver" in window)) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px 150px 0px" }
        );
        revealEls.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
